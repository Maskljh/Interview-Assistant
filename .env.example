HTTP_ADDR=:18080
# Docker MySQL 默认密码 123456（与 docker-compose.yml 的 MYSQL_ROOT_PASSWORD 一致）；
# 宿主机端口 3307（本机 MySQL 占 3306，容器内仍为 3306）
MYSQL_DSN=root:123456@tcp(127.0.0.1:3307)/interview?parseTime=true&charset=utf8mb4&loc=Local
# Redis 宿主机端口 16379（6379 在 Windows 排除端口范围内无法绑定，容器内仍为 6379）
REDIS_ADDR=127.0.0.1:16379
JWT_SECRET=dev-change-me

# WPS 开放平台应用凭证（登录唯一方式；缺省时 /api/auth/wps/* 返回 503）
WPS_CLIENT_ID=
WPS_CLIENT_SECRET=
WPS_REDIRECT_URI=http://127.0.0.1:18365/callback
WPS_CALLBACK_ADDR=:18365
# 云文档导入/报告邮件需要 drive/file/mail 权限
WPS_SCOPE=kso.user_base.read,kso.drive.readwrite,kso.file.read,kso.file_search.readwrite,kso.mail.readwrite,kso.mailbox.read
WPS_FRONTEND_REDIRECT=http://localhost:5174

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_NLS_APP_KEY=
# 阿里云 OCR（图片导入；缺省回退到上方 ALIYUN_ACCESS_KEY_ID/SECRET）
ALIYUN_OCR_ACCESS_KEY_ID=
ALIYUN_OCR_ACCESS_KEY_SECRET=
ALIYUN_OCR_ENDPOINT=https://ocr-api.cn-hangzhou.aliyuncs.com/

# 阿里云 OSS（简历/JD 文件服务端代理上传；缺省时文件上传返回 502，填写 JD 文本不受影响）
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# GitHub Personal Access Token（可选；不填时公开 API 限流 60 次/小时，填入后 5000 次/小时）
GITHUB_TOKEN=
